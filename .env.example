# App Config (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Neon Database (Required for Vercel)
# Get from Neon Dashboard → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/east3?sslmode=require

# API Proxy Config (Required for Vercel/Netlify)
# DO NOT put these in the Expo app itself, only on Netlify/Vercel or your local API server
#
# OpenRouter is the ONLY AI provider used for chat. The server automatically picks
# FREE models (`:free`) from the OpenRouter model list and falls back to another
# free model whenever one is rate-limited (429) / exhausted (402) / removed (404).
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: comma-separated priority order of free models (final fallback = openrouter/free)
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,inclusionai/ling-3.0-flash-vl:free
JWT_SECRET=your-jwt-secret-change-me

# Optional — vector embeddings only (no free OpenRouter embedding endpoint exists yet).
# When not set, semantic search degrades to keyword search (app keeps working).
# GEMINI_API_KEY=your-gemini-api-key