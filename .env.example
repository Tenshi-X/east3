# App Config (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Neon Database (Required for Vercel)
# Get from Neon Dashboard → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/east3?sslmode=require

# API Proxy Config (Required for Vercel)
# DO NOT put these in the Expo app itself, only on Vercel or your local API server
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
JWT_SECRET=your-jwt-secret-change-me